# Bearer token required on every route except /health. Leave empty to disable auth.
# Generate one with: openssl rand -base64 32
VOICE_API_KEY=change-me-to-a-long-random-string
# auto | cuda | mps | cpu
VOICE_DEVICE=auto
# Load the model at startup (1) or on the first request (0)
VOICE_PRELOAD=1
# Default language for new voices: auto, en, pt, es, ...
VOICE_DEFAULT_LANGUAGE=auto
# mp3 | wav | opus | flac | pcm
VOICE_DEFAULT_FORMAT=mp3
# Diffusion steps: 16 = fast, 32 = best quality
VOICE_NUM_STEP=16
# Denoise and dereverb reference clips with DeepFilterNet on registration
VOICE_CLEAN_REFS=1
# Free VRAM after N idle seconds (0 = keep the model loaded)
VOICE_IDLE_UNLOAD_SECONDS=0
# Hugging Face token, only if your network requires it (the model is public)
HF_TOKEN=
